# Copy to .env (gitignored) and fill in. Never commit real values.
GITHUB_TOKEN=
GROQ_API_KEY=
# groq (default) | none ; gemini planned
LLM_PROVIDER=groq
# any Groq model with strict JSON-schema output, e.g. openai/gpt-oss-20b or openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# ---- web UI (python -m triage web); on Render set these as environment variables ----
# password for Run scan / Approve / Refresh CI (viewing is public)
APP_PASSWORD=
# long random string that signs the session cookie: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
# Postgres URL (Neon) for all state + LangGraph checkpoints; empty = local SQLite triage.db / checkpoints.db
DATABASE_URL=
# repo the web UI scans (fixed server-side)
TRIAGE_REPO=angelina10504/dep-triage-demo
# 1 when served over HTTPS (the Dockerfile sets it)
COOKIE_SECURE=
